<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title><%= title %> – EvaluadorIA</title>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet"/>
  <link rel="stylesheet" href="/css/app.css"/>
</head>
<body class="bg-slate-50 font-sans text-slate-700 min-h-screen flex">
  <%- include('../partials/sidebar') %>
  <div class="flex-1 flex flex-col ml-64">
    <%- include('../partials/topbar') %>
    <main class="flex-1 p-6">
      <% if (locals.flashMessages && flashMessages.length > 0) { %>
        <div class="mb-4 space-y-2">
          <% flashMessages.forEach(msg => { %>
            <div class="flex items-center gap-3 px-4 py-3 rounded-lg text-sm font-medium <%= msg.type === 'success' ? 'bg-green-50 border border-green-200 text-green-800' : 'bg-red-50 border border-red-200 text-red-800' %>">
              <%= msg.message %>
              <button onclick="this.parentElement.remove()" class="ml-auto">✕</button>
            </div>
          <% }) %>
        </div>
      <% } %>

      <div class="mb-6 flex items-center justify-between">
        <div>
          <h1 class="page-title">Historial de Evaluaciones</h1>
          <p class="page-subtitle">Registro global de todas las calificaciones emitidas por el modelo de Inteligencia Artificial.</p>
        </div>
      </div>

      <div class="card overflow-hidden">
        <% if (evaluations && evaluations.length > 0) { %>
          <div class="table-wrapper">
            <table class="data-table">
              <thead>
                <tr>
                  <th>Estudiante</th>
                  <th>Actividad</th>
                  <th>Asignatura</th>
                  <th>Proveedor / Modelo</th>
                  <th>Calificación</th>
                  <th>Fecha</th>
                  <th class="text-right">Acciones</th>
                </tr>
              </thead>
              <tbody>
                <% evaluations.forEach(ev => { %>
                  <tr>
                    <td class="font-medium text-slate-800">
                      <%= ev.submission && ev.submission.student ? ev.submission.student.fullName : 'Desconocido' %>
                    </td>
                    <td>
                      <%= ev.submission && ev.submission.activity ? ev.submission.activity.title : '' %>
                    </td>
                    <td class="text-xs text-slate-500">
                      <%= ev.submission && ev.submission.activity && ev.submission.activity.subject ? ev.submission.activity.subject.name : '' %>
                    </td>
                    <td>
                      <span class="badge badge-blue text-[10px]">
                        <%= ev.aiProvider || 'No registrado' %> (<%= ev.aiModel || 'Sin modelo' %>)
                      </span>
                    </td>
                    <td>
                      <span class="font-bold <%= ev.percentage >= 70 ? 'text-green-600' : ev.percentage >= 50 ? 'text-yellow-600' : 'text-red-600' %>">
                        <%= ev.totalScore %> / <%= ev.maxScore %>
                      </span>
                      <span class="text-xs text-slate-400 font-medium">(<%= Math.round(ev.percentage) %>%)</span>
                    </td>
                    <td class="text-xs text-slate-500">
                      <%= new Date(ev.createdAt).toLocaleDateString('es-ES') %>
                    </td>
                    <td class="text-right">
                      <a href="/evaluaciones/<%= ev.id %>" class="btn-secondary btn-sm">Ver Informe</a>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <div class="empty-state p-12">
            <p class="text-slate-500 mb-2">No se han realizado evaluaciones aún en la plataforma.</p>
            <a href="/actividades" class="btn-primary btn-sm">Ir a Actividades</a>
          </div>
        <% } %>
      </div>
    </main>
  </div>

  <script src="/js/app.js"></script>
</body>
</html>
