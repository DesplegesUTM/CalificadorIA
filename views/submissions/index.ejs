<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title><%= title %> – EvaluadorIA</title>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet"/>
  <link rel="stylesheet" href="/css/app.css"/>
</head>
<body class="bg-slate-50 font-sans text-slate-700 min-h-screen flex">
  <%- include('../partials/sidebar') %>
  <div class="flex-1 flex flex-col ml-64">
    <%- include('../partials/topbar') %>
    <main class="flex-1 p-6">
      <% if (locals.flashMessages && flashMessages.length > 0) { %>
        <div class="mb-4 space-y-2">
          <% flashMessages.forEach(msg => { %>
            <div class="flex items-center gap-3 px-4 py-3 rounded-lg text-sm font-medium <%= msg.type === 'success' ? 'bg-green-50 border border-green-200 text-green-800' : 'bg-red-50 border border-red-200 text-red-800' %>">
              <%= msg.message %>
              <button type="button" data-dismiss-flash class="ml-auto">✕</button>
            </div>
          <% }) %>
        </div>
      <% } %>

      <div class="mb-6 flex items-center justify-between">
        <div>
          <a href="/actividades/<%= activity.id %>" class="text-xs text-blue-600 hover:underline flex items-center gap-1 mb-1">
            ← Volver a <%= activity.title %>
          </a>
          <h1 class="page-title">Entregas de Estudiantes</h1>
          <p class="page-subtitle">Monitorea el estado de procesamiento, lecturas y evaluaciones de los documentos.</p>
        </div>
        <div class="flex gap-2">
          <a href="/entregas/actividad/<%= activity.id %>/subir" class="btn-primary">
            + Importar Entregas
          </a>
        </div>
      </div>

      <div class="card overflow-hidden">
        <div class="p-4 border-b border-slate-200 flex items-center justify-between bg-slate-50/50">
          <div class="text-sm font-medium text-slate-700">
            Total: <span class="font-bold"><%= submissions.length %></span> documentos
          </div>
          <% if (submissions.some(s => s.status === 'PENDING')) { %>
            <button
              type="button"
              data-evaluate-batch="<%= submissions.filter(s => s.status === 'PENDING').map(s => s.id).join(',') %>"
              class="btn-primary bg-indigo-600 hover:bg-indigo-700 btn-sm">
              ⚡ Evaluar Todas las Pendientes (<%= submissions.filter(s => s.status === 'PENDING').length %>)
            </button>
          <% } %>
        </div>

        <% if (submissions && submissions.length > 0) { %>
          <div class="table-wrapper">
            <table class="data-table">
              <thead>
                <tr>
                  <th>Estudiante</th>
                  <th>Identificación</th>
                  <th>Archivo</th>
                  <th>Estado</th>
                  <th>Calificación</th>
                  <th>Fecha</th>
                  <th class="text-right">Acciones</th>
                </tr>
              </thead>
              <tbody>
                <% submissions.forEach(sub => { %>
                  <tr>
                    <td class="font-medium text-slate-800">
                      <%= sub.student ? sub.student.fullName : 'No identificado' %>
                    </td>
                    <td class="text-xs text-slate-500">
                      <%= sub.student ? (sub.student.studentId || sub.student.email) : '--' %>
                    </td>
                    <td class="max-w-xs truncate text-xs" title="<%= sub.originalFile %>">
                      <%= sub.originalFile %>
                    </td>
                    <td>
                      <% if (sub.status === 'EVALUATED') { %>
                        <span class="badge badge-green">Evaluado</span>
                      <% } else if (sub.status === 'PENDING') { %>
                        <span class="badge badge-yellow">Pendiente</span>
                      <% } else if (sub.status === 'ILLEGIBLE') { %>
                        <span class="badge badge-slate">Ilegible</span>
                      <% } else { %>
                        <span class="badge badge-red">Error</span>
                      <% } %>
                    </td>
                    <td>
                      <% if (sub.evaluations && sub.evaluations.length > 0) { %>
                        <span class="font-bold text-slate-800"><%= sub.evaluations[0].totalScore %></span>
                        <span class="text-xs text-slate-400">/ <%= sub.evaluations[0].maxScore %> (<%= Math.round(sub.evaluations[0].percentage) %>%)</span>
                      <% } else { %>
                        <span class="text-slate-400 text-xs">--</span>
                      <% } %>
                    </td>
                    <td class="text-xs text-slate-500">
                      <%= new Date(sub.createdAt).toLocaleDateString('es-ES') %>
                    </td>
                    <td class="text-right space-x-2">
                      <% if (sub.evaluations && sub.evaluations.length > 0) { %>
                        <a href="/evaluaciones/<%= sub.evaluations[0].id %>" class="btn-secondary btn-sm">Ver</a>
                      <% } else { %>
                        <button type="button" data-evaluate-submission="<%= sub.id %>" class="btn-primary btn-sm bg-blue-600 hover:bg-blue-700">
                          Evaluar
                        </button>
                      <% } %>
                      <button
                        type="button"
                        data-delete-submission="<%= sub.id %>"
                        class="text-slate-300 hover:text-red-600 p-1 text-xs">
                        Eliminar
                      </button>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <div class="empty-state p-12">
            <p class="text-slate-500 mb-4">No se han registrado entregas todavía para esta actividad.</p>
            <a href="/entregas/actividad/<%= activity.id %>/subir" class="btn-primary">Subir entregas</a>
          </div>
        <% } %>
      </div>
    </main>
  </div>

  <script src="/js/app.js"></script>
</body>
</html>
