<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Iniciar sesión – EvaluadorIA</title>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet"/>
  <link rel="stylesheet" href="/css/app.css"/>
</head>
<body class="min-h-screen font-sans flex" style="background: linear-gradient(135deg, #0f172a 0%, #1e3a5f 50%, #1e40af 100%);">

  <!-- Left decorative panel -->
  <div class="hidden lg:flex lg:w-1/2 flex-col justify-center items-center p-12 text-white">
    <div class="max-w-md text-center">
      <div class="w-20 h-20 bg-white/10 backdrop-blur rounded-2xl flex items-center justify-center mx-auto mb-8">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
        </svg>
      </div>
      <h1 class="text-4xl font-bold mb-4">EvaluadorIA</h1>
      <p class="text-xl text-blue-200 mb-8">Sistema de Evaluación Académica con Inteligencia Artificial</p>
      <div class="space-y-4 text-left">
        <div class="flex items-start gap-3 bg-white/10 rounded-xl p-4">
          <span class="text-2xl">🎯</span>
          <div>
            <p class="font-semibold">Evaluación automática</p>
            <p class="text-sm text-blue-200">Califica resúmenes y ensayos con IA en segundos</p>
          </div>
        </div>
        <div class="flex items-start gap-3 bg-white/10 rounded-xl p-4">
          <span class="text-2xl">📋</span>
          <div>
            <p class="font-semibold">Rúbricas dinámicas</p>
            <p class="text-sm text-blue-200">Configura criterios de evaluación a medida</p>
          </div>
        </div>
        <div class="flex items-start gap-3 bg-white/10 rounded-xl p-4">
          <span class="text-2xl">📊</span>
          <div>
            <p class="font-semibold">Reportes Excel</p>
            <p class="text-sm text-blue-200">Exporta calificaciones y retroalimentación</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Login form panel -->
  <div class="w-full lg:w-1/2 flex items-center justify-center p-8 bg-white">
    <div class="w-full max-w-md">
      
      <!-- Mobile logo -->
      <div class="flex items-center gap-3 mb-8 lg:hidden">
        <div class="w-10 h-10 bg-blue-700 rounded-xl flex items-center justify-center">
          <svg class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
          </svg>
        </div>
        <span class="text-xl font-bold text-slate-800">EvaluadorIA</span>
      </div>

      <h2 class="text-2xl font-bold text-slate-800 mb-1">Bienvenido</h2>
      <p class="text-slate-500 mb-8">Inicie sesión para acceder al sistema</p>

      <% if (locals.error && error) { %>
        <div class="flex items-center gap-3 p-4 rounded-xl bg-red-50 border border-red-200 text-red-700 text-sm mb-6">
          <svg class="w-5 h-5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          <%= error %>
        </div>
      <% } %>

      <% if (locals.success && success) { %>
        <div class="mb-6 rounded-xl border border-green-200 bg-green-50 p-4 text-sm text-green-700" role="status">
          <%= success %>
        </div>
      <% } %>

      <form method="POST" action="/auth/login" class="space-y-5">

        <div class="form-group">
          <label class="form-label" for="email">Correo electrónico</label>
          <input 
            type="email" 
            id="email" 
            name="email"
            required
            class="form-input"
            placeholder="correo@institución.edu"
            autocomplete="email"
          />
        </div>

        <div class="form-group">
          <div class="flex items-center justify-between">
            <label class="form-label" for="password">Contraseña</label>
          </div>
          <input 
            type="password" 
            id="password" 
            name="password"
            required
            class="form-input"
            placeholder="••••••••"
            autocomplete="current-password"
          />
        </div>

        <button type="submit" class="w-full bg-blue-700 hover:bg-blue-800 text-white font-semibold py-3 rounded-xl transition-colors text-sm">
          Iniciar sesión
        </button>

      </form>

      <p class="mt-5 text-center text-sm text-slate-600">
        ¿No tienes cuenta?
        <a href="/auth/register" class="font-semibold text-blue-700 hover:text-blue-800">Regístrate</a>
      </p>

      <div class="mt-8 p-4 bg-slate-50 rounded-xl border border-slate-200">
        <p class="text-xs text-slate-500 font-medium mb-2">Credenciales de demostración:</p>
        <div class="space-y-1 text-xs text-slate-600 font-mono">
          <p>👑 Admin: admin@evaluadoria.com / admin123</p>
          <p>👨‍🏫 Docente: docente@evaluadoria.com / docente123</p>
        </div>
      </div>

    </div>
  </div>

  <script>
    // Auto-fill demo credentials on click
    document.querySelectorAll('.demo-cred').forEach(el => {
      el.addEventListener('click', () => {
        document.getElementById('email').value = el.dataset.email;
        document.getElementById('password').value = el.dataset.pass;
      });
    });
  </script>
</body>
</html>
