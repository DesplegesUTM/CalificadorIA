<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title><%= title %> – EvaluadorIA</title>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet"/>
  <link rel="stylesheet" href="/css/app.css"/>
</head>
<body class="min-h-screen font-sans flex items-center justify-center p-6" style="background: linear-gradient(135deg, #0f172a 0%, #1e3a5f 50%, #1e40af 100%);">
  <main class="w-full max-w-md rounded-2xl bg-white p-8 shadow-xl">
    <a href="/auth/login" class="text-sm font-semibold text-blue-700 hover:text-blue-800">EvaluadorIA</a>
    <h1 class="mt-6 text-2xl font-bold text-slate-800">Crear una cuenta</h1>
    <p class="mb-6 mt-1 text-sm text-slate-500">Regístrate para empezar a usar el sistema como docente.</p>

    <% if (locals.error && error) { %>
      <div class="mb-5 rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-700" role="alert">
        <%= error %>
      </div>
    <% } %>

    <form method="POST" action="/auth/register" class="space-y-4">
      <div>
        <label class="form-label" for="name">Nombre completo</label>
        <input class="form-input" type="text" id="name" name="name" value="<%= name %>" required maxlength="120" autocomplete="name"/>
      </div>
      <div>
        <label class="form-label" for="email">Correo electrónico</label>
        <input class="form-input" type="email" id="email" name="email" value="<%= email %>" required autocomplete="email"/>
      </div>
      <div>
        <label class="form-label" for="password">Contraseña</label>
        <input class="form-input" type="password" id="password" name="password" required minlength="6" autocomplete="new-password"/>
        <p class="mt-1 text-xs text-slate-500">Debe tener al menos 6 caracteres.</p>
      </div>
      <div>
        <label class="form-label" for="confirmPassword">Confirmar contraseña</label>
        <input class="form-input" type="password" id="confirmPassword" name="confirmPassword" required minlength="6" autocomplete="new-password"/>
      </div>
      <button type="submit" class="w-full rounded-xl bg-blue-700 py-3 text-sm font-semibold text-white transition-colors hover:bg-blue-800">
        Crear cuenta
      </button>
    </form>

    <p class="mt-6 text-center text-sm text-slate-600">
      ¿Ya tienes cuenta?
      <a href="/auth/login" class="font-semibold text-blue-700 hover:text-blue-800">Inicia sesión</a>
    </p>
  </main>
</body>
</html>
