<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title><%= title %> – EvaluadorIA</title>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet"/>
  <link rel="stylesheet" href="/css/app.css"/>
</head>
<body class="bg-slate-50 font-sans text-slate-700 min-h-screen flex">
  <%- include('../partials/sidebar') %>
  <div class="flex-1 flex flex-col ml-64">
    <%- include('../partials/topbar') %>
    <main class="flex-1 p-6">
      <% if (locals.flashMessages && flashMessages.length > 0) { %>
        <div class="mb-4 space-y-2">
          <% flashMessages.forEach(msg => { %>
            <div class="flex items-center gap-3 px-4 py-3 rounded-lg text-sm font-medium <%= msg.type === 'success' ? 'bg-green-50 border border-green-200 text-green-800' : 'bg-red-50 border border-red-200 text-red-800' %>">
              <%= msg.message %>
              <button onclick="this.parentElement.remove()" class="ml-auto">✕</button>
            </div>
          <% }) %>
        </div>
      <% } %>

      <div class="mb-6 flex items-center justify-between">
        <div>
          <a href="/actividades/<%= activity.id %>" class="text-xs text-blue-600 hover:underline flex items-center gap-1 mb-1">
            ← Volver a <%= activity.title %>
          </a>
          <h1 class="page-title">Contexto Académico</h1>
          <p class="page-subtitle">Información fundamental que la Inteligencia Artificial utilizará como criterio de verdad y referencia para evaluar.</p>
        </div>
      </div>

      <div class="card max-w-4xl p-6">
        <% if (locals.errors && errors.length > 0) { %>
          <div class="alert-error mb-6">
            <ul class="list-disc list-inside">
              <% errors.forEach(err => { %>
                <li><%= err %></li>
              <% }) %>
            </ul>
          </div>
        <% } %>

        <form method="POST" action="/contextos/actividad/<%= activity.id %>" class="space-y-6">
          <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
            <p class="text-sm text-slate-500">Puedes copiar aquí los campos que ya definiste en la actividad.</p>
            <button
              type="button"
              data-import-context
              data-description="<%= activity.description || '' %>"
              data-objectives="<%= activity.objectives || '' %>"
              data-instructions="<%= activity.instructions || '' %>"
              class="btn-secondary text-sm">
              Importar campos de actividad
            </button>
          </div>

          <div class="form-group">
            <label class="form-label" for="description">Descripción Detallada del Ejercicio</label>
            <textarea id="description" name="description" rows="3" class="form-textarea" placeholder="Ej. El estudiante debe elaborar una síntesis crítica..."><%= context ? context.description : '' %></textarea>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="form-group">
              <label class="form-label" for="objectives">Objetivos de Aprendizaje</label>
              <textarea id="objectives" name="objectives" rows="4" class="form-textarea" placeholder="Competencias esperadas en el ensayo..."><%= context ? context.objectives : '' %></textarea>
            </div>

            <div class="form-group">
              <label class="form-label" for="instructions">Instrucciones dadas al Estudiante</label>
              <textarea id="instructions" name="instructions" rows="4" class="form-textarea" placeholder="Requisitos de formato, extensión, tono..."><%= context ? context.instructions : '' %></textarea>
            </div>
          </div>

          <div class="form-group bg-blue-50/50 p-4 rounded-xl border border-blue-100">
            <label class="form-label font-bold text-blue-900" for="baseText">Texto Base o Contenido de Referencia (Crítico)</label>
            <p class="text-xs text-slate-500 mb-2">Pega aquí el contenido, lectura, artículo o documento fuente sobre el cual los estudiantes trabajaron.</p>
            <textarea id="baseText" name="baseText" rows="8" class="form-textarea bg-white" placeholder="Pegar el texto de lectura principal..."><%= context ? context.baseText : '' %></textarea>
          </div>

          <div class="form-group">
            <label class="form-label" for="additionalInfo">Información Complementaria para el Evaluador IA</label>
            <textarea id="additionalInfo" name="additionalInfo" rows="3" class="form-textarea" placeholder="Consideraciones particulares, errores comunes a penalizar, lineamientos específicos..."><%= context ? context.additionalInfo : '' %></textarea>
          </div>

          <div class="flex justify-end gap-3 pt-4 border-t border-slate-100">
            <a href="/actividades/<%= activity.id %>" class="btn-secondary">Cancelar</a>
            <button type="submit" class="btn-primary">Guardar Contexto</button>
          </div>
        </form>
      </div>
    </main>
  </div>
  <script src="/js/app.js"></script>
</body>
</html>
