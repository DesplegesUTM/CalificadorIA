<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> – EvaluadorIA</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/app.css" />
</head>
<body class="bg-slate-50 font-sans text-slate-700 min-h-screen flex">
  <%- include('../partials/sidebar') %>
  <div class="flex-1 flex flex-col ml-64">
    <%- include('../partials/topbar') %>
    <main class="flex-1 p-6">

      <!-- Flash messages -->
      <% if (locals.flashMessages && flashMessages.length > 0) { %>
        <div class="mb-4 space-y-2">
          <% flashMessages.forEach(msg => { %>
            <div class="flex items-center gap-3 px-4 py-3 rounded-lg text-sm font-medium <%= msg.type === 'success' ? 'bg-green-50 border border-green-200 text-green-800' : 'bg-red-50 border border-red-200 text-red-800' %>">
              <%= msg.message %>
              <button onclick="this.parentElement.remove()" class="ml-auto text-current opacity-60 hover:opacity-100">✕</button>
            </div>
          <% }) %>
        </div>
      <% } %>

      <!-- Page Header -->
      <div class="flex items-center justify-between mb-6">
        <div>
          <h1 class="text-2xl font-bold text-slate-800">Asignaturas</h1>
          <p class="text-slate-500 text-sm mt-1">Gestiona las asignaturas del sistema</p>
        </div>
        <a href="/asignaturas/nueva" class="inline-flex items-center gap-2 bg-blue-700 hover:bg-blue-800 text-white font-semibold px-4 py-2.5 rounded-lg text-sm transition shadow-sm">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
          </svg>
          Nueva asignatura
        </a>
      </div>

      <!-- Table Card -->
      <div class="bg-white rounded-xl shadow-sm border border-slate-200">
        <% if (locals.subjects && subjects.length > 0) { %>
          <div class="overflow-x-auto">
            <table class="w-full text-sm">
              <thead>
                <tr class="bg-slate-50 border-b border-slate-200">
                  <th class="text-left px-6 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wide">Nombre</th>
                  <th class="text-left px-6 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wide">Código</th>
                  <th class="text-left px-6 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wide">Docente</th>
                  <th class="text-left px-6 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wide">Actividades</th>
                  <th class="text-left px-6 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wide">Estado</th>
                  <th class="text-right px-6 py-3 text-xs font-semibold text-slate-500 uppercase tracking-wide">Acciones</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100">
                <% subjects.forEach(subject => { %>
                  <tr class="hover:bg-slate-50 transition">
                    <td class="px-6 py-3.5">
                      <div>
                        <p class="font-semibold text-slate-800"><%= subject.name %></p>
                        <% if (subject.description) { %>
                          <p class="text-xs text-slate-400 mt-0.5 truncate max-w-xs"><%= subject.description %></p>
                        <% } %>
                      </div>
                    </td>
                    <td class="px-6 py-3.5">
                      <% if (subject.code) { %>
                        <span class="inline-flex items-center px-2 py-0.5 rounded bg-slate-100 text-slate-700 text-xs font-mono font-semibold"><%= subject.code %></span>
                      <% } else { %>
                        <span class="text-slate-400 text-xs">—</span>
                      <% } %>
                    </td>
                    <td class="px-6 py-3.5 text-slate-600">
                      <%= subject.user ? subject.user.name : '—' %>
                    </td>
                    <td class="px-6 py-3.5">
                      <span class="inline-flex items-center gap-1.5 text-slate-700">
                        <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2"/>
                        </svg>
                        <%= subject._count ? subject._count.activities : 0 %>
                      </span>
                    </td>
                    <td class="px-6 py-3.5">
                      <% if (subject.active) { %>
                        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold bg-green-50 text-green-700 border border-green-200">
                          <span class="w-1.5 h-1.5 rounded-full bg-green-500"></span>Activa
                        </span>
                      <% } else { %>
                        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold bg-slate-100 text-slate-500 border border-slate-200">
                          <span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span>Inactiva
                        </span>
                      <% } %>
                    </td>
                    <td class="px-6 py-3.5">
                      <div class="flex items-center justify-end gap-2">
                        <a href="/asignaturas/<%= subject.id %>/editar" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-white border border-slate-300 hover:bg-slate-50 text-slate-700 rounded-lg text-xs font-medium transition">
                          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                          </svg>
                          Editar
                        </a>
                        <form method="POST" action="/asignaturas/<%= subject.id %>/estado" class="inline" onsubmit="return confirm('¿Cambiar estado de esta asignatura?')">
                          <input type="hidden" name="_method" value="PATCH" />
                          <button type="submit" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-white border <%= subject.active ? 'border-red-200 hover:bg-red-50 text-red-600' : 'border-green-200 hover:bg-green-50 text-green-600' %> rounded-lg text-xs font-medium transition">
                            <%= subject.active ? 'Desactivar' : 'Activar' %>
                          </button>
                        </form>
                      </div>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <!-- Empty State -->
          <div class="flex flex-col items-center justify-center py-20 px-4">
            <div class="w-16 h-16 rounded-full bg-blue-50 flex items-center justify-center mb-4">
              <svg class="w-8 h-8 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
              </svg>
            </div>
            <p class="text-slate-700 font-semibold text-lg">No hay asignaturas</p>
            <p class="text-slate-400 text-sm mt-1 mb-5">Crea tu primera asignatura para comenzar</p>
            <a href="/asignaturas/nueva" class="inline-flex items-center gap-2 bg-blue-700 hover:bg-blue-800 text-white font-semibold px-4 py-2.5 rounded-lg text-sm transition">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
              </svg>
              Nueva asignatura
            </a>
          </div>
        <% } %>
      </div>

    </main>
  </div>
  <script src="/js/app.js"></script>
</body>
</html>
