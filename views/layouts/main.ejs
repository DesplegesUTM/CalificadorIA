<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> – EvaluadorIA</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/app.css" />
</head>
<body class="bg-slate-50 font-inter text-slate-700 min-h-screen flex">

  <%- include('../partials/sidebar') %>

  <div class="flex-1 flex flex-col min-w-0 ml-64">
    <%- include('../partials/topbar') %>

    <main class="flex-1 p-6 overflow-y-auto">

      <%# Flash messages %>
      <% if (locals.flashMessages && flashMessages.length > 0) { %>
        <div class="mb-4 space-y-2" id="flash-container">
          <% flashMessages.forEach(msg => { %>
            <div class="flash-msg flex items-center gap-3 px-4 py-3 rounded-lg border text-sm font-medium
              <%= msg.type === 'success' ? 'bg-green-50 border-green-200 text-green-800' : 
                  msg.type === 'error' ? 'bg-red-50 border-red-200 text-red-800' : 
                  'bg-blue-50 border-blue-200 text-blue-800' %>">
              <span>
                <%= msg.type === 'success' ? '✓' : msg.type === 'error' ? '✕' : 'ℹ' %>
              </span>
              <%= msg.message %>
              <button onclick="this.parentElement.remove()" class="ml-auto opacity-60 hover:opacity-100">✕</button>
            </div>
          <% }) %>
        </div>
      <% } %>

      <%- body %>

    </main>
  </div>

  <script src="/js/app.js"></script>
  <%- typeof extraScripts !== 'undefined' ? extraScripts : '' %>
</body>
</html>
