<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title><%= title %> – EvaluadorIA</title>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet"/>
  <link rel="stylesheet" href="/css/app.css"/>
</head>
<body class="bg-slate-50 font-sans text-slate-700 min-h-screen flex">
  <%- include('../partials/sidebar') %>
  <div class="flex-1 flex flex-col ml-64">
    <%- include('../partials/topbar') %>
    <main class="flex-1 p-6">
      <% if (locals.flashMessages && flashMessages.length > 0) { %>
        <div class="mb-4 space-y-2">
          <% flashMessages.forEach(msg => { %>
            <div class="flex items-center gap-3 px-4 py-3 rounded-lg text-sm font-medium <%= msg.type === 'success' ? 'bg-green-50 border border-green-200 text-green-800' : 'bg-red-50 border border-red-200 text-red-800' %>">
              <%= msg.message %>
              <button onclick="this.parentElement.remove()" class="ml-auto">✕</button>
            </div>
          <% }) %>
        </div>
      <% } %>

      <!-- Page Header -->
      <div class="page-header">
        <div>
          <h1 class="page-title">Dashboard</h1>
          <p class="page-subtitle">Bienvenido, <%= user ? user.name : '' %></p>
        </div>
      </div>

      <!-- Stats Grid -->
      <div class="grid grid-cols-2 lg:grid-cols-3 xl:grid-cols-6 gap-4 mb-8">
        
        <div class="stat-card">
          <div class="stat-icon bg-blue-100">
            <svg class="w-5 h-5 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
            </svg>
          </div>
          <div>
            <p class="text-2xl font-bold text-slate-800"><%= stats.subjects %></p>
            <p class="text-xs text-slate-500">Asignaturas</p>
          </div>
        </div>

        <div class="stat-card">
          <div class="stat-icon bg-indigo-100">
            <svg class="w-5 h-5 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
            </svg>
          </div>
          <div>
            <p class="text-2xl font-bold text-slate-800"><%= stats.activities %></p>
            <p class="text-xs text-slate-500">Actividades</p>
          </div>
        </div>

        <div class="stat-card">
          <div class="stat-icon bg-slate-100">
            <svg class="w-5 h-5 text-slate-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
            </svg>
          </div>
          <div>
            <p class="text-2xl font-bold text-slate-800"><%= stats.total %></p>
            <p class="text-xs text-slate-500">Total entregas</p>
          </div>
        </div>

        <div class="stat-card">
          <div class="stat-icon bg-green-100">
            <svg class="w-5 h-5 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </div>
          <div>
            <p class="text-2xl font-bold text-slate-800"><%= stats.evaluated %></p>
            <p class="text-xs text-slate-500">Evaluadas</p>
          </div>
        </div>

        <div class="stat-card">
          <div class="stat-icon bg-yellow-100">
            <svg class="w-5 h-5 text-yellow-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </div>
          <div>
            <p class="text-2xl font-bold text-slate-800"><%= stats.pending %></p>
            <p class="text-xs text-slate-500">Pendientes</p>
          </div>
        </div>

        <div class="stat-card">
          <div class="stat-icon bg-purple-100">
            <svg class="w-5 h-5 text-purple-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
            </svg>
          </div>
          <div>
            <p class="text-2xl font-bold text-slate-800"><%= stats.average %>%</p>
            <p class="text-xs text-slate-500">Promedio</p>
          </div>
        </div>

      </div>

      <!-- Quick Actions + Recent Evaluations -->
      <div class="grid lg:grid-cols-3 gap-6">

        <!-- Quick Actions -->
        <div class="card p-6">
          <h3 class="font-semibold text-slate-800 mb-4">Acciones rápidas</h3>
          <div class="space-y-3">
            <a href="/actividades/nueva" class="flex items-center gap-3 p-3 rounded-lg hover:bg-slate-50 transition-colors border border-slate-200">
              <div class="w-9 h-9 bg-blue-100 rounded-lg flex items-center justify-center">
                <svg class="w-5 h-5 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
              </div>
              <div>
                <p class="text-sm font-medium text-slate-700">Nueva actividad</p>
                <p class="text-xs text-slate-400">Crear actividad de evaluación</p>
              </div>
            </a>
            <a href="/asignaturas/nueva" class="flex items-center gap-3 p-3 rounded-lg hover:bg-slate-50 transition-colors border border-slate-200">
              <div class="w-9 h-9 bg-indigo-100 rounded-lg flex items-center justify-center">
                <svg class="w-5 h-5 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13"/></svg>
              </div>
              <div>
                <p class="text-sm font-medium text-slate-700">Nueva asignatura</p>
                <p class="text-xs text-slate-400">Registrar asignatura</p>
              </div>
            </a>
            <a href="/evaluaciones" class="flex items-center gap-3 p-3 rounded-lg hover:bg-slate-50 transition-colors border border-slate-200">
              <div class="w-9 h-9 bg-green-100 rounded-lg flex items-center justify-center">
                <svg class="w-5 h-5 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6"/></svg>
              </div>
              <div>
                <p class="text-sm font-medium text-slate-700">Ver evaluaciones</p>
                <p class="text-xs text-slate-400">Consultar resultados</p>
              </div>
            </a>
            <% if (user && user.role === 'ADMIN') { %>
            <a href="/admin/configuracion-ia" class="flex items-center gap-3 p-3 rounded-lg hover:bg-slate-50 transition-colors border border-slate-200">
              <div class="w-9 h-9 bg-purple-100 rounded-lg flex items-center justify-center">
                <svg class="w-5 h-5 text-purple-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3"/></svg>
              </div>
              <div>
                <p class="text-sm font-medium text-slate-700">Configurar IA</p>
                <p class="text-xs text-slate-400">Administrar proveedores</p>
              </div>
            </a>
            <% } %>
          </div>
        </div>

        <!-- Recent Evaluations -->
        <div class="lg:col-span-2 card">
          <div class="p-5 border-b border-slate-100 flex items-center justify-between">
            <h3 class="font-semibold text-slate-800">Evaluaciones recientes</h3>
            <a href="/evaluaciones" class="text-sm text-blue-600 hover:text-blue-700">Ver todas →</a>
          </div>
          <% if (recentEvaluations && recentEvaluations.length > 0) { %>
            <div class="divide-y divide-slate-100">
              <% recentEvaluations.forEach(ev => { %>
                <div class="flex items-center gap-4 px-5 py-3.5 hover:bg-slate-50/50 transition-colors">
                  <div class="w-9 h-9 rounded-full bg-blue-100 flex items-center justify-center text-blue-700 font-semibold text-sm flex-shrink-0">
                    <%= (ev.submission?.student?.fullName || 'E').charAt(0).toUpperCase() %>
                  </div>
                  <div class="flex-1 min-w-0">
                    <p class="text-sm font-medium text-slate-700 truncate"><%= ev.submission?.student?.fullName || 'Desconocido' %></p>
                    <p class="text-xs text-slate-400 truncate"><%= ev.submission?.activity?.title || '' %></p>
                  </div>
                  <div class="text-right flex-shrink-0">
                    <p class="text-sm font-bold <%= ev.percentage >= 70 ? 'text-green-600' : ev.percentage >= 50 ? 'text-yellow-600' : 'text-red-600' %>">
                      <%= Math.round(ev.percentage) %>%
                    </p>
                    <p class="text-xs text-slate-400"><%= ev.totalScore %>/<%= ev.maxScore %></p>
                  </div>
                  <a href="/evaluaciones/<%= ev.id %>" class="text-slate-400 hover:text-blue-600 transition-colors">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
                  </a>
                </div>
              <% }) %>
            </div>
          <% } else { %>
            <div class="empty-state py-12">
              <div class="empty-state-icon">
                <svg class="w-8 h-8 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
              </div>
              <p class="text-slate-500 text-sm">No hay evaluaciones aún</p>
              <a href="/actividades" class="mt-2 text-sm text-blue-600 hover:text-blue-700">Ir a actividades →</a>
            </div>
          <% } %>
        </div>
      </div>

    </main>
  </div>
  <script src="/js/app.js"></script>
</body>
</html>
