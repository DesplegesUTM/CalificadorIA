{
  "name": "evaluadoria",
  "version": "1.0.0",
  "description": "Sistema de evaluación académica con inteligencia artificial",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build:css": "npx tailwindcss -i ./public/css/input.css -o ./public/css/app.css --minify",
    "watch:css": "npx tailwindcss -i ./public/css/input.css -o ./public/css/app.css --watch",
    "db:migrate": "npx prisma migrate dev",
    "db:generate": "npx prisma generate",
    "db:seed": "node prisma/seed.js",
    "db:studio": "npx prisma studio",
    "setup": "npm run db:generate && npm run db:migrate && npm run db:seed && npm run build:css",
    "postinstall": "npx prisma generate"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@google/genai": "^2.3.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "adm-zip": "^0.6.1",
    "bcryptjs": "^3.0.3",
    "connect-pg-simple": "^10.0.0",
    "connect-sqlite3": "^0.9.18",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "ejs": "^7.0.2",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "multer": "^2.5.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.14.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.5",
    "autoprefixer": "^10.6.2",
    "postcss": "^8.5.33",
    "prisma": "^7.10.1",
    "tailwindcss": "^3.4.17"
  }
}
