generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  password     String
  role         Role     @default(TEACHER)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  subjects     Subject[]
  activities   AcademicActivity[]

  @@map("users")
}

enum Role {
  ADMIN
  TEACHER
}

model Subject {
  id          Int      @id @default(autoincrement())
  name        String
  code        String?  @unique
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId      Int
  user        User     @relation(fields: [userId], references: [id])
  activities  AcademicActivity[]

  @@map("subjects")
}

model AcademicActivity {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  objectives  String?
  instructions String?
  status      ActivityStatus @default(ACTIVE)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId      Int
  user        User     @relation(fields: [userId], references: [id])
  subjectId   Int
  subject     Subject  @relation(fields: [subjectId], references: [id])

  context     AcademicContext?
  rubric      Rubric?
  submissions Submission[]

  @@map("academic_activities")
}

enum ActivityStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

model AcademicContext {
  id              Int      @id @default(autoincrement())
  description     String?
  objectives      String?
  instructions    String?
  baseText        String?
  additionalInfo  String?
  referenceFiles  String?  // JSON array of file paths
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  activityId      Int      @unique
  activity        AcademicActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@map("academic_contexts")
}

model Rubric {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  totalScore  Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  activityId  Int      @unique
  activity    AcademicActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  criteria    RubricCriterion[]

  @@map("rubrics")
}

model RubricCriterion {
  id           Int      @id @default(autoincrement())
  name         String
  description  String?
  maxScore     Float
  weight       Float    @default(1)
  levels       String?  // JSON: [{name, description, scorePercentage}]
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  rubricId     Int
  rubric       Rubric   @relation(fields: [rubricId], references: [id], onDelete: Cascade)
  scores       CriterionScore[]

  @@map("rubric_criteria")
}

model Student {
  id          Int      @id @default(autoincrement())
  fullName    String
  email       String?
  studentId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  submissions Submission[]

  @@map("students")
}

model Submission {
  id           Int      @id @default(autoincrement())
  title        String?
  originalFile String
  storedFile   String
  fileSize     Int?
  mimeType     String?
  textContent  String?
  status       SubmissionStatus @default(PENDING)
  metadata     String?  // JSON: extra info
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  studentId    Int
  student      Student  @relation(fields: [studentId], references: [id])
  activityId   Int
  activity     AcademicActivity @relation(fields: [activityId], references: [id])
  evaluations  Evaluation[]

  @@map("submissions")
}

enum SubmissionStatus {
  PENDING
  EVALUATED
  ERROR
  ILLEGIBLE
}

model Evaluation {
  id              Int      @id @default(autoincrement())
  totalScore      Float
  maxScore        Float
  percentage      Float
  feedback        String?
  strengths       String?
  weaknesses      String?
  recommendations String?
  aiProvider      String?
  aiModel         String?
  promptVersion   String?
  rawResponse     String?
  status          EvalStatus @default(COMPLETED)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  submissionId    Int
  submission      Submission @relation(fields: [submissionId], references: [id])
  criterionScores CriterionScore[]

  @@map("evaluations")
}

enum EvalStatus {
  COMPLETED
  FAILED
  IN_PROGRESS
}

model CriterionScore {
  id              Int      @id @default(autoincrement())
  score           Float
  maxScore        Float
  justification   String?
  strengths       String?
  weaknesses      String?
  createdAt       DateTime @default(now())

  evaluationId    Int
  evaluation      Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  criterionId     Int
  criterion       RubricCriterion @relation(fields: [criterionId], references: [id])

  @@map("criterion_scores")
}

model AIProviderConfiguration {
  id           Int      @id @default(autoincrement())
  name         String
  provider     AIProvider
  apiKey       String?
  model        String?
  isActive     Boolean  @default(false)
  isDefault    Boolean  @default(false)
  status       String   @default("unconfigured")
  config       String?  // JSON extra config
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("ai_provider_configurations")
}

enum AIProvider {
  GEMINI
  OPENAI
  CLAUDE
}
