# ============================================================
# EVALUADOR IA - Variables de Entorno
# Copiar este archivo como .env y completar los valores
# ============================================================

# --- Servidor ---
NODE_ENV=development
PORT=3000

# --- Base de Datos PostgreSQL ---
DATABASE_URL="postgresql://postgres:TU_CONTRASENA@localhost:5432/evaluadoria?schema=public"

# --- Sesiones ---
SESSION_SECRET=cambia_este_secreto_por_uno_seguro_de_al_menos_32_caracteres

# --- Google Gemini API ---
GEMINI_API_KEY=PEGA_AQUI_TU_API_KEY_DE_GEMINI
GEMINI_MODEL=gemini-3.8-flash

# --- OpenAI (Opcional) ---
# OPENAI_API_KEY=tu_api_key_de_openai_aqui
# OPENAI_MODEL=gpt-4o

# --- Anthropic Claude (Opcional) ---
# ANTHROPIC_API_KEY=tu_api_key_de_claude_aqui
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# --- Archivos ---
MAX_FILE_SIZE_MB=50
UPLOAD_DIR=uploads
EXPORT_DIR=exports
